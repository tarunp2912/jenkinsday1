pipeline{
    agent{
        //using agent machine call by label
        label "phpdev"
    }
     options {
        // Timeout counter starts AFTER agent is allocated
        timeout(time: 60, unit: 'SECONDS')
    }

    stages{
        stage("CodeCheckout"){
            steps{
                git branch: 'clothstore', url: 'https://github.com/tarunp2912/jenkinsday1.git'
            }
        }

        stage("PHPCodeDeploy"){
            steps{
            sh "sudo cp -r /home/ec2-user/jenkins/workspace/clothstore/src/clothstore/* /var/www/html/"
            }
        }
        
        stage("RestartServer"){
            steps{
                sh "sudo systemctl restart httpd"
            }
        }
    }
}