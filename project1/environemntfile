pipeline{
    agent{
        //using agent machine call by label
        label "ciserver"
    }
     options {
        // Timeout counter starts AFTER agent is allocated
        timeout(time: 60, unit: 'SECONDS')
    }
    environment { 
        CONTAINERIMAGE = "nginx"
    }

    stages{
        stage("PullImage"){
            steps{
                sh "docker pull $CONTAINERIMAGE"
            }
        }

        stage("KillOldContainer"){
            steps{
            sh "docker rm -f ciserver"
            }
        }
        
        stage("BildContainer"){
            steps{
                sh "docker run -dit --name ciserver $CONTAINERIMAGE"
            }
        }
    }
}